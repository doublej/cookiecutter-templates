{
  "families": {
    "python": {
      "templates": [
        "python/cli",
        "python/fastapi",
        "python/flask"
      ],
      "identical_files": [
        "hooks/pre_gen_project.py",
        "{{cookiecutter.project_slug}}/.gitignore",
        "{{cookiecutter.project_slug}}/.quality.json"
      ],
      "justfile_shared_recipes": [
        "default",
        "install",
        "lint",
        "lint-fix",
        "format",
        "format-check",
        "typecheck",
        "test",
        "loc-check",
        "dir-check",
        "i18n-check",
        "just-fmt-check",
        "check",
        "clean",
        "claude-tree",
        "update-scaffold"
      ]
    },
    "typescript": {
      "templates": [
        "typescript/node-api",
        "typescript/node-cli",
        "typescript/bun-package",
        "typescript/node-lib",
        "typescript/node-worker",
        "typescript/react",
        "typescript/sveltekit",
        "typescript/tizen-tv",
        "typescript/nextjs"
      ],
      "identical_files": [
        "hooks/pre_gen_project.py"
      ],
      "justfile_shared_recipes": [
        "default",
        "install",
        "lint",
        "lint-fix",
        "test",
        "loc-check",
        "dir-check",
        "i18n-check",
        "just-fmt-check",
        "check",
        "build",
        "clean",
        "claude-tree",
        "update-scaffold"
      ],
      "justfile_exceptions": {
        "typescript/sveltekit": {
          "skip_recipes": [
            "typecheck",
            "clean",
            "check"
          ]
        },
        "typescript/tizen-tv": {
          "skip_recipes": [
            "typecheck",
            "clean",
            "check"
          ]
        },
        "typescript/nextjs": {
          "skip_recipes": [
            "clean",
            "check"
          ]
        },
        "typescript/react": {
          "skip_recipes": [
            "check"
          ]
        }
      }
    },
    "swift": {
      "templates": [
        "swift/ios",
        "swift/macos"
      ],
      "identical_files": [
        "hooks/pre_gen_project.py",
        "{{cookiecutter.project_slug}}/.gitignore",
        "{{cookiecutter.project_slug}}/.quality.json",
        "{{cookiecutter.project_slug}}/.swiftlint.yml"
      ],
      "justfile_shared_recipes": [
        "default",
        "install",
        "xcode",
        "lint",
        "lint-fix",
        "test",
        "loc-check",
        "dir-check",
        "i18n-check",
        "just-fmt-check",
        "check",
        "build",
        "build-release",
        "clean",
        "claude-tree",
        "update-scaffold"
      ]
    },
    "rust": {
      "templates": [
        "rust/cli"
      ],
      "identical_files": [
        "hooks/pre_gen_project.py",
        "{{cookiecutter.project_slug}}/.gitignore"
      ],
      "justfile_shared_recipes": [
        "default",
        "lint",
        "fmt",
        "fmt-check",
        "just-fmt-check",
        "check",
        "test",
        "loc-check",
        "dir-check",
        "i18n-check",
        "build-release",
        "reinstall",
        "claude-tree",
        "update-scaffold"
      ]
    },
    "go": {
      "templates": [
        "go/cli",
        "go/api"
      ],
      "identical_files": [
        "hooks/pre_gen_project.py",
        "{{cookiecutter.project_slug}}/.gitignore",
        "{{cookiecutter.project_slug}}/.quality.json"
      ],
      "justfile_shared_recipes": [
        "default",
        "install",
        "lint",
        "fmt",
        "fmt-check",
        "test",
        "loc-check",
        "dir-check",
        "i18n-check",
        "just-fmt-check",
        "check",
        "build",
        "build-release",
        "clean",
        "claude-tree",
        "update-scaffold"
      ]
    },
    "shopify": {
      "templates": [
        "shopify/theme"
      ],
      "identical_files": [
        "hooks/pre_gen_project.py",
        "{{cookiecutter.project_slug}}/.gitignore",
        "{{cookiecutter.project_slug}}/.quality.json",
        "{{cookiecutter.project_slug}}/.theme-check.yml",
        "{{cookiecutter.project_slug}}/.claude/agents/deploy-runner.md"
      ],
      "justfile_shared_recipes": [
        "default",
        "dev",
        "share",
        "lint",
        "lint-fix",
        "loc-check",
        "dir-check",
        "i18n-check",
        "just-fmt-check",
        "check",
        "pull",
        "push",
        "claude-tree",
        "update-scaffold"
      ]
    }
  },
  "cross_family": {
    "identical_files": [
      "{{cookiecutter.project_slug}}/.claude/settings.json",
      "{{cookiecutter.project_slug}}/.claude/scripts/_diag.py",
      "{{cookiecutter.project_slug}}/.claude/scripts/check_template_update.py",
      "{{cookiecutter.project_slug}}/.claude/scripts/check_library_freshness.py",
      "{{cookiecutter.project_slug}}/.claude/scripts/snooze_library_check.py",
      "{{cookiecutter.project_slug}}/.claude/agents/verify-runner.md",
      "{{cookiecutter.project_slug}}/.claude/tickets/README.md",
      "{{cookiecutter.project_slug}}/.claude/scripts/check_i18n.py"
    ],
    "slug_dir_overrides": {},
    "exclude_templates": []
  },
  "merge_paths": {
    "description": "JSON files that update_scaffold.py shallow-merges instead of overwriting: upstream fields missing locally are added; existing local values are preserved so user edits survive.",
    "files": [
      ".atlas"
    ]
  }
}
