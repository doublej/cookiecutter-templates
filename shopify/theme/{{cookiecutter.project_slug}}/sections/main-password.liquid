<section class="password section">
  <div class="page-width password__inner">
    <h1 class="password__title">{{ shop.name }}</h1>

    {%- if shop.password_message != blank -%}
      <div class="password__message rte">{{ shop.password_message }}</div>
    {%- endif -%}

    <details class="password__login">
      <summary class="button">{{ 'general.password_page.login_form_heading' | t }}</summary>
      {%- form 'storefront_password', class: 'password__form' -%}
        {{ form.errors | default_errors }}
        <label for="password-input" class="visually-hidden">
          {{ 'general.password_page.login_form_password_label' | t }}
        </label>
        <input
          type="password"
          name="password"
          id="password-input"
          placeholder="{{ 'general.password_page.login_form_password_placeholder' | t }}"
          autocomplete="current-password"
        >
        <button type="submit" class="button">
          {{ 'general.password_page.login_form_submit' | t }}
        </button>
      {%- endform -%}
    </details>
  </div>
</section>

{% stylesheet %}
  .password__inner {
    max-width: 28rem;
    margin-inline: auto;
    text-align: center;
    padding-block: var(--space-xl);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.main_password.name",
  "tag": "section",
  "class": "section-main-password",
  "settings": []
}
{% endschema %}
