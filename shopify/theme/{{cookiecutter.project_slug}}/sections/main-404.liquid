<section class="error-404 section">
  <div class="page-width error-404__inner">
    <h1 class="error-404__title">{{ 'general.404.title' | t }}</h1>
    <p class="error-404__body">{{ 'general.404.body' | t }}</p>
    <a href="{{ routes.root_url }}" class="button">{{ 'general.404.continue_shopping' | t }}</a>
  </div>
</section>

{% stylesheet %}
  .error-404__inner {
    text-align: center;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.main_404.name",
  "tag": "section",
  "class": "section-main-404",
  "settings": []
}
{% endschema %}
