<section class="list-collections section">
  <div class="page-width">
    <h1 class="list-collections__title">{{ 'collections.general.title' | t }}</h1>

    <ul class="list-collections__grid product-grid" role="list">
      {%- for collection in collections -%}
        <li class="list-collections__item">
          <a href="{{ collection.url }}" class="list-collections__link">
            {%- if collection.featured_image -%}
              {%- assign collection_image_alt = collection.title | escape -%}
              {{
                collection.featured_image
                | image_url: width: 600
                | image_tag:
                  loading: 'lazy',
                  alt: collection_image_alt,
                  widths: '300, 600',
                  sizes: '(min-width: 750px) 25vw, 50vw'
              }}
            {%- else -%}
              {{ 'collection-1' | placeholder_svg_tag: 'placeholder' }}
            {%- endif -%}
            <h2 class="list-collections__name">{{ collection.title }}</h2>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% stylesheet %}
  .list-collections__link {
    text-decoration: none;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.main_list_collections.name",
  "tag": "section",
  "class": "section-main-list-collections",
  "settings": []
}
{% endschema %}
