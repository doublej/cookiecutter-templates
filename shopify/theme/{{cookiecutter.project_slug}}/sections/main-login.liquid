<section class="login section">
  <div class="page-width login__inner">
    <h1 class="login__title">{{ 'customer.login.title' | t }}</h1>

    {%- form 'customer_login', class: 'login__form' -%}
      {{ form.errors | default_errors }}

      <div class="field">
        <label for="customer-email">{{ 'customer.login.email' | t }}</label>
        <input
          type="email"
          name="customer[email]"
          id="customer-email"
          autocomplete="email"
          required
        >
      </div>

      <div class="field">
        <label for="customer-password">{{ 'customer.login.password' | t }}</label>
        <input
          type="password"
          name="customer[password]"
          id="customer-password"
          autocomplete="current-password"
          required
        >
      </div>

      <button type="submit" class="button">{{ 'customer.login.submit' | t }}</button>

      <a href="{{ routes.account_recover_url }}" class="login__recover">
        {{ 'customer.login.forgot_password' | t }}
      </a>
    {%- endform -%}

    <a href="{{ routes.account_register_url }}" class="login__create">
      {{ 'customer.login.create_account' | t }}
    </a>

    <details class="login__recover-form" id="recover-password">
      <summary>{{ 'customer.recover_password.title' | t }}</summary>
      <p class="login__recover-subtext">{{ 'customer.recover_password.subtext' | t }}</p>
      {%- form 'recover_customer_password', class: 'login__recover' -%}
        {{ form.errors | default_errors }}
        {%- if form.posted_successfully? -%}
          <p class="login__recover-success">{{ 'customer.recover_password.success' | t }}</p>
        {%- endif -%}
        <div class="field">
          <label for="recover-email">{{ 'customer.recover_password.email' | t }}</label>
          <input
            type="email"
            name="email"
            id="recover-email"
            autocomplete="email"
            required
          >
        </div>
        <button type="submit" class="button">{{ 'customer.recover_password.submit' | t }}</button>
      {%- endform -%}
    </details>
  </div>
</section>

{% stylesheet %}
  .login__inner {
    max-width: 28rem;
    margin-inline: auto;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    margin-block-end: var(--space-md);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.main_login.name",
  "tag": "section",
  "class": "section-main-login",
  "settings": []
}
{% endschema %}
