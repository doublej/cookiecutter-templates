<section class="reset-password section">
  <div class="page-width reset-password__inner">
    <h1 class="reset-password__title">{{ 'customer.reset_password.title' | t }}</h1>
    <p class="reset-password__subtext">{{ 'customer.reset_password.subtext' | t }}</p>

    {%- form 'reset_customer_password', class: 'reset-password__form' -%}
      {{ form.errors | default_errors }}

      <div class="field">
        <label for="reset-password">{{ 'customer.reset_password.password' | t }}</label>
        <input
          type="password"
          name="customer[password]"
          id="reset-password"
          autocomplete="new-password"
          required
        >
      </div>

      <div class="field">
        <label for="reset-password-confirm">{{ 'customer.reset_password.password_confirm' | t }}</label>
        <input
          type="password"
          name="customer[password_confirmation]"
          id="reset-password-confirm"
          autocomplete="new-password"
          required
        >
      </div>

      <button type="submit" class="button">{{ 'customer.reset_password.submit' | t }}</button>
    {%- endform -%}
  </div>
</section>

{% stylesheet %}
  .reset-password__inner {
    max-width: 28rem;
    margin-inline: auto;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.main_reset_password.name",
  "tag": "section",
  "class": "section-main-reset-password",
  "settings": []
}
{% endschema %}
