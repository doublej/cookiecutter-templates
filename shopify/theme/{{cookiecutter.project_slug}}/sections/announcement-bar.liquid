<div class="announcement-bar" style="--announcement-bg: {{ section.settings.background }}; --announcement-fg: {{ section.settings.text_color }};">
  <div class="page-width announcement-bar__inner">
    {%- if section.settings.link != blank -%}
      <a href="{{ section.settings.link }}" class="announcement-bar__text">
        {{ section.settings.text }}
      </a>
    {%- else -%}
      <p class="announcement-bar__text">{{ section.settings.text }}</p>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .announcement-bar {
    color: var(--announcement-fg);
    background-color: var(--announcement-bg);
    text-align: center;
  }

  .announcement-bar__inner {
    padding-block: var(--space-2xs);
  }

  .announcement-bar__text {
    margin: 0;
    font-size: 0.875rem;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.announcement_bar.name",
  "tag": "aside",
  "class": "section-announcement-bar",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "default": "t:sections.announcement_bar.settings.text.default",
      "label": "t:sections.announcement_bar.settings.text.label"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:sections.announcement_bar.settings.link.label"
    },
    {
      "type": "color",
      "id": "background",
      "default": "#121212",
      "label": "t:settings_schema.colors.settings.color_background.label"
    },
    {
      "type": "color",
      "id": "text_color",
      "default": "#ffffff",
      "label": "t:settings_schema.colors.settings.color_foreground.label"
    }
  ],
  "presets": [
    {
      "name": "t:sections.announcement_bar.presets.name"
    }
  ]
}
{% endschema %}
