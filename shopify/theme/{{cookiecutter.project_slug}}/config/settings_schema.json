[
  {
    "name": "theme_info",
    "theme_name": "{{ cookiecutter.project_name }}",
    "theme_version": "1.0.0",
    "theme_author": "{{ cookiecutter.author }}",
    "theme_documentation_url": "https://shopify.dev/docs/themes",
    "theme_support_url": "https://shopify.dev/docs/themes"
  },
  {
    "name": "t:settings_schema.colors.name",
    "settings": [
      {
        "type": "color",
        "id": "color_background",
        "label": "t:settings_schema.colors.settings.color_background.label",
        "default": "#ffffff"
      },
      {
        "type": "color",
        "id": "color_foreground",
        "label": "t:settings_schema.colors.settings.color_foreground.label",
        "default": "#121212"
      },
      {
        "type": "color",
        "id": "color_accent",
        "label": "t:settings_schema.colors.settings.color_accent.label",
        "default": "#1773b0"
      }
    ]
  },
  {
    "name": "t:settings_schema.layout.name",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "t:settings_schema.layout.settings.logo.label"
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "t:settings_schema.layout.settings.favicon.label",
        "info": "t:settings_schema.layout.settings.favicon.info"
      },
      {
        "type": "range",
        "id": "page_width",
        "min": 60,
        "max": 100,
        "step": 5,
        "unit": "t:settings_schema.layout.settings.page_width.unit",
        "label": "t:settings_schema.layout.settings.page_width.label",
        "default": 80
      }
    ]
  }
]
