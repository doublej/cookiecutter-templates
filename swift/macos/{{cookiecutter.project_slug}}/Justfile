set shell := ["zsh", "-uo", "pipefail", "-c"]
set unstable := true

default:
    @just --list
    @echo ''
    @echo "branch: $(git branch --show-current 2>/dev/null || echo 'n/a')"

[group('setup')]
install:
    swift package resolve
    @command -v swiftlint >/dev/null 2>&1 || echo 'warn: swiftlint not installed — run: brew install swiftlint'

# Never `swift run`: a bare SwiftPM binary has no Info.plist, so AppKit starts it `prohibited`
# (no Dock icon, no Cmd-Tab, no focus); inside a bundle it starts `regular` (measured 2026-10-14).
# A menu bar app opts out on purpose, with LSUIElement in `bundle`.

# Run it as an app
[group('develop')]
run-app: bundle
    open .build/{{ cookiecutter.module_name }}.app

alias run := run-app

[group('develop')]
xcode:
    open Package.swift

[group('quality')]
lint:
    swiftlint lint --strict

[group('quality')]
lint-fix:
    swiftlint --fix && swiftlint lint --strict

[group('quality')]
just-fmt-check:
    just --fmt --check

[group('quality')]
test:
    swift test

[group('quality')]
loc-check:
    #!/usr/bin/env zsh
    setopt null_glob
    eval "$(python3 -c "
    import json, shlex
    c = json.load(open('.quality.json'))
    print(f'WARN={c[\"loc\"][\"warn\"]}')
    print(f'ERROR={c[\"loc\"][\"error\"]}')
    g = c['globs']
    print(f'GLOBS=({shlex.join(g)})')
    ")"
    err=0
    for pattern in $GLOBS; do
        for f in ${~pattern}; do
            lines=$(wc -l < "$f")
            if (( lines > ERROR )); then echo "error: $f ($lines lines, max $ERROR)"; err=1
            elif (( lines > WARN )); then echo "warn: $f ($lines lines, target ≤$WARN — don't trim, split the file!)"; fi
        done
    done
    exit $err

[group('quality')]
dir-check:
    #!/usr/bin/env zsh
    setopt null_glob
    eval "$(python3 -c "
    import json, shlex
    c = json.load(open('.quality.json'))
    print(f'MAX={c[\"dir\"][\"max_files\"]}')
    g = c['globs']
    print(f'GLOBS=({shlex.join(g)})')
    ")"
    err=0
    typeset -A counts
    for pattern in $GLOBS; do
        for f in ${~pattern}; do
            dir=${f:h}
            counts[$dir]=$(( ${counts[$dir]:-0} + 1 ))
        done
    done
    for dir count in ${(kv)counts}; do
        if (( count > MAX )); then
            echo "error: $dir ($count files, max $MAX)"
            err=1
        fi
    done
    exit $err

[group('quality')]
i18n-check:
    python3 .claude/scripts/check_i18n.py

[group('quality')]
check:
    @echo '→ Checking Justfile format...'
    just just-fmt-check
    @echo '→ Checking file lengths...'
    just loc-check
    @echo '→ Checking directory sizes...'
    just dir-check
    @echo '→ Checking translations...'
    just i18n-check
    @echo '→ Running lint...'
    just lint
    @echo '→ Running build...'
    just build
    @echo '→ Running tests...'
    just test

[group('build')]
build:
    swift build

# SwiftPM's resource bundle goes in Contents/Resources: the generated `Bundle.module` looks there
# first and has no fallback to the build folder, so an app without it crashes at the first string.

# Wrap the binary in .build/{{ cookiecutter.module_name }}.app, ad-hoc signed
[group('build')]
bundle:
    #!/usr/bin/env zsh
    set -euo pipefail
    swift build
    app=.build/{{ cookiecutter.module_name }}.app
    plist=$app/Contents/Info.plist
    rm -rf $app
    bin=$(swift build --show-bin-path)
    mkdir -p $app/Contents/MacOS $app/Contents/Resources
    cp $bin/{{ cookiecutter.module_name }} $app/Contents/MacOS/
    for resources in $bin/*.bundle(N); do cp -R $resources $app/Contents/Resources/; done
    plutil -create xml1 $plist
    for key value in \
        CFBundleIdentifier dev.jurrejan.{{ cookiecutter.project_slug }} \
        CFBundleName {{ cookiecutter.module_name }} \
        CFBundleExecutable {{ cookiecutter.module_name }} \
        CFBundlePackageType APPL \
        CFBundleShortVersionString 0.1.0 \
        CFBundleDevelopmentRegion en \
        LSMinimumSystemVersion {{ cookiecutter.deployment_target }}; do
        plutil -insert $key -string $value $plist
    done
    plutil -insert CFBundleLocalizations -json '["en","nl"]' $plist
    codesign --force --sign - $app

[group('build')]
build-release:
    swift build -c release

[group('cleanup')]
clean:
    swift package clean
    rm -rf .build/

# Open this project's CLAUDE.md tree in the project-atlas viewer, https://github.com/doublej/project-atlas (via the global `atlas` CLI)
[group('docs')]
claude-tree:
    atlas tree

[group('scaffold')]
update-scaffold *ARGS:
    #!/usr/bin/env zsh
    set -euo pipefail
    repo="${COOKIECUTTER_TEMPLATES:-}"
    if [[ -z "$repo" && -f .template-meta.json ]]; then
        repo=$(python3 -c "import json; print(json.load(open('.template-meta.json'))['template_source']['path'])" 2>/dev/null || true)
    fi
    if [[ -z "$repo" || ! -d "$repo" ]]; then
        echo "error: cookiecutter-templates repo not found — set \$COOKIECUTTER_TEMPLATES or fix template_source.path in .template-meta.json" >&2
        exit 1
    fi
    python3 "$repo/tools/update_scaffold.py" {% raw %}{{ ARGS }}{% endraw %}
