{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "{{ cookiecutter.extension_slug }}",
  "title": "{{ cookiecutter.project_name }}",
  "description": "{{ cookiecutter.description }}",
  "icon": "command-icon.png",
  "author": "{{ cookiecutter.author }}",
  "categories": ["Developer Tools"],
  "license": "MIT",
  "commands": [
    {
      "name": "hello",
      "title": "Hello",
      "description": "Starter view command — replace with your own",
      "mode": "view"
    }
  ],
  "preferences": [
    {
      "name": "extraPath",
      "type": "textfield",
      "title": "Extra PATH dirs",
      "description": "Colon-separated dirs prepended to PATH for spawned binaries (Raycast has no user PATH)",
      "default": "/opt/homebrew/bin:/usr/local/bin:$HOME/.bun/bin:$HOME/.local/bin",
      "required": false
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.104.0",
    "@raycast/utils": "^2.2.0"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.2.0",
    "@types/node": "^26.0.0",
    "@types/react": "^19.0.0",
    "eslint": "^10.0.0",
    "typescript": "^5.9.0"
  },
  "scripts": {
    "build": "ray build --skip-types -e dist -o dist",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint"
  }
}
