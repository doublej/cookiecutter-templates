{
  "name": "{{ cookiecutter.project_slug }}",
  "version": "0.1.0",
  "description": "{{ cookiecutter.description }}",
  "author": "{{ cookiecutter.author }}",
  "type": "module",
  "scripts": {
    "prepare": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --strategy localStorage preferredLanguage baseLocale",
    "dev": "vite dev --port {{ cookiecutter.port }}",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest --passWithNoTests",
    "lint": "biome check . && stylelint '**/*.{css,svelte}'",
    "lint:fix": "biome check --write . && stylelint --fix '**/*.{css,svelte}'"
  },
  "dependencies": {
    "gsap": "^3.15.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@inlang/paraglide-js": "^2.28.0",
    "@inlang/plugin-message-format": "^4.5.4",
    "postcss-html": "^1.8.1",
    "stylelint": "^17.16.0",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.5",
    "svelte": "^5.57.2",
    "svelte-check": "^4.0.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.4",
    "vitest": "^4.1.11"
  }
}
