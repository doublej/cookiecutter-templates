{
  "name": "{{ cookiecutter.project_slug }}",
  "version": "0.1.0",
  "description": "{{ cookiecutter.description }}",
  "author": "{{ cookiecutter.author }}",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack -p {{ cookiecutter.port }}",
    "build": "next build",
    "start": "next start",
    "lint": "biome check . && stylelint '**/*.css'",
    "lint:fix": "biome check --write . && stylelint --fix '**/*.css'",
    "test": "vitest"
  },
  "dependencies": {
    "@gsap/react": "^2.1.0",
    "gsap": "^3.15.0",
    "next": "^16.4.1",
    "next-intl": "^4.14.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "stylelint": "^17.16.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "typescript": "^5.9.0",
    "vitest": "^4.1.11"
  }
}
