{
  "name": "{{ cookiecutter.project_slug }}",
  "version": "0.1.0",
  "description": "{{ cookiecutter.description }}",
  "author": "{{ cookiecutter.author }}",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack -p {{ cookiecutter.port }}",
    "build": "next build",
    "start": "next start",
    "lint": "biome check . && stylelint '**/*.css'",
    "lint:fix": "biome check --write . && stylelint --fix '**/*.css'",
    "test": "vitest"
  },
  "dependencies": {
    "@gsap/react": "^2.1.0",
    "gsap": "^3.13.0",
    "next": "^16.3.5",
    "next-intl": "^4.14.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "stylelint": "^17.0.0",
    "@types/node": "^26.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.5",
    "jsdom": "^30.0.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.0"
  }
}
